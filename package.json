{
  "name": "flower-cake-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:configure": "node scripts/supabase-db-env.mjs --write",
    "db:push": "node scripts/run-with-supabase-db.mjs npx prisma db push",
