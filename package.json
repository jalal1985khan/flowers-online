    "db:migrate-images": "node scripts/run-with-supabase-db.mjs node scripts/migrate-product-images.mjs",
    "db:restore-images": "node scripts/run-with-supabase-db.mjs node scripts/restore-product-images.mjs",
    "db:cleanup-branding": "node scripts/run-with-supabase-db.mjs node scripts/cleanup-legacy-branding.mjs",
    "db:strip-blocked-images": "node scripts/run-with-supabase-db.mjs node scripts/strip-blocked-product-images.mjs",
    "db:studio": "node scripts/run-with-supabase-db.mjs npx prisma studio",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.12.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
